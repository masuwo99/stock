    function saveItemFromForm() {
      const id = document.getElementById('itemId').value;
      const form = document.getElementById('itemForm');
      const selectedComp = form.querySelector('input[name="itemCompartment"]:checked')?.value || 'fridge';

      const itemData = {
        id: id || ('item-' + Date.now() + '-' + Math.random().toString(36).substring(2, 6)),
        name: document.getElementById('itemName').value.trim(),
        compartment: selectedComp,
        quantity: parseFloat(document.getElementById('itemQuantity').value) || 1,
        unit: document.getElementById('itemUnit').value,
        purchaseDate: document.getElementById('itemPurchaseDate').value,
        expiryDate: document.getElementById('itemExpiryDate').value,
        expiryType: document.getElementById('itemExpiryType').value,
        memo: document.getElementById('itemMemo').value.trim(),
        updatedAt: Date.now()
      };

      if (!id) {
        items.unshift(itemData);
        broadcastSyncEvent({ type: 'ITEM_ADDED', item: itemData });
        showToast(`「${itemData.name}」を追加しました`, 'success');
      } else {
        const idx = items.findIndex(i => i.id === id);
        if (idx !== -1) {
          items[idx] = itemData;
          broadcastSyncEvent({ type: 'ITEM_UPDATED', item: itemData });
          showToast(`「${itemData.name}」を更新しました`, 'info');
        }
      }

      persistItemsLocally();
      closeAllModals();
      render();
    }

    window.editItem = function(id) {
      const item = items.find(i => i.id === id);
      if (item) openItemModal(item);
    };

    window.changeQuantity = function(id, delta) {
      const item = items.find(i => i.id === id);
      if (!item) return;

      const newQty = Math.max(0, parseFloat((item.quantity + delta).toFixed(2)));
      if (newQty === 0) {
        consumeItem(id);
        return;
      }

      item.quantity = newQty;
      item.updatedAt = Date.now();
      persistItemsLocally();
      broadcastSyncEvent({ type: 'ITEM_UPDATED', item: item });
      render();
    };

    window.consumeItem = function(id) {
      const item = items.find(i => i.id === id);
      const name = item ? item.name : 'アイテム';
      items = items.filter(i => i.id !== id);
      persistItemsLocally();
      broadcastSyncEvent({ type: 'ITEM_DELETED', id: id });
      render();
      showToast(`「${name}」を消費しました！`, 'success');
    };

    // --- レシート自動読み取り (Gemini 3 Flash Vision) ---
    function resetReceiptModal() {
      document.getElementById('receiptDropZone').classList.remove('hidden');
      document.getElementById('receiptScanningView').classList.add('hidden');
      document.getElementById('receiptResultView').classList.add('hidden');
      document.getElementById('receiptFileInput').value = '';
