<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>StockPal - スマート冷蔵庫ストック管理</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=M+PLUS+Rounded+1c:wght@500;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script>
    try {
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              sans: ['"M PLUS Rounded 1c"', 'Inter', 'sans-serif'],
            },
            colors: {
              fridge: '#3b82f6',
              chilled: '#06b6d4',
              vegetable: '#10b981',
              freezer: '#8b5cf6',
            }
          }
        }
      };
    } catch(e) {
      console.warn("Tailwind config warning:", e);
    }
  </script>

  <style>
    /* 基本レイアウトフォールバック（CDN遅延時でも真っ白にならない設計） */
    html, body {
      margin: 0;
      padding: 0;
      background-color: #f8fafc;
      color: #1e293b;
      font-family: "M PLUS Rounded 1c", "Inter", sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    html { scroll-behavior: smooth; }
    
    .glass-effect {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(12px);
    }
    
    .badge-pulse {
      animation: pulseAlert 2s infinite ease-in-out;
    }
    @keyframes pulseAlert {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.04); }
    }
    
    /* スクロールバー */
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans selection:bg-blue-100 selection:text-blue-700">

  <!-- ヘッダー -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
    <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      <!-- ロゴ -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-600 via-teal-500 to-emerald-400 flex items-center justify-center text-white shadow-md shadow-blue-500/20">
          <i class="fa-solid fa-kitchen-set text-lg"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-blue-700 to-teal-600 bg-clip-text text-transparent">StockPal</h1>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 border border-blue-200">AI搭載</span>
          </div>
          <p class="text-xs text-slate-500 hidden sm:block">冷蔵庫ストック管理 & リアルタイム共有</p>
        </div>
      </div>

      <!-- 同期ステータス ＆ アクション -->
      <div class="flex items-center space-x-2 sm:space-x-3">
        <!-- リアルタイム同期ボタン / ステータス -->
        <button type="button" id="btnShareModal" class="flex items-center space-x-2 px-3 py-1.5 rounded-full border border-slate-200 hover:border-blue-400 bg-white hover:bg-blue-50/50 text-slate-700 transition shadow-xs text-xs font-semibold">
          <span id="syncIndicator" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span id="syncStatusText" class="hidden md:inline">共有・同期中</span>
          <i class="fa-solid fa-users text-blue-600"></i>
        </button>

        <!-- レシート読み取りボタン -->
        <button type="button" id="btnOpenReceiptModal" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white shadow-xs shadow-orange-500/20 transition text-xs sm:text-sm font-bold">
          <i class="fa-solid fa-receipt"></i>
          <span class="hidden sm:inline">レシート読み取り</span>
          <span class="sm:hidden">スキャン</span>
        </button>

        <!-- 献立提案ボタン -->
        <button type="button" id="btnOpenMealModal" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white shadow-xs shadow-teal-500/20 transition text-xs sm:text-sm font-bold">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
          <span class="hidden sm:inline">AI献立提案</span>
          <span class="sm:hidden">献立</span>
        </button>
      </div>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="flex-1 max-w-6xl w-full mx-auto p-4 sm:p-6 space-y-6">

    <!-- アラート・ステータスサマリーカード -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
          <i class="fa-solid fa-boxes-stacked"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">ストック総数</p>
          <p id="statTotalItems" class="text-xl font-extrabold text-slate-800">0</p>
        </div>
      </div>
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg">
          <i class="fa-solid fa-clock text-amber-500"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">3日以内に期限</p>
          <p id="statExpiringSoon" class="text-xl font-extrabold text-amber-600">0</p>
        </div>
      </div>
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-lg">
          <i class="fa-solid fa-triangle-exclamation text-rose-500"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">期限切れ</p>
          <p id="statExpired" class="text-xl font-extrabold text-rose-600">0</p>
        </div>
      </div>
      <div class="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-xs flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg">
          <i class="fa-solid fa-temperature-arrow-down text-emerald-500"></i>
        </div>
        <div>
          <p class="text-xs text-slate-500 font-medium">共有ルーム</p>
          <p id="statRoomCode" class="text-xs font-mono font-bold text-slate-700 truncate max-w-[90px] sm:max-w-[120px]">Room-XXXX</p>
        </div>
      </div>
    </div>

    <!-- 冷蔵庫各室セレクター (タブ) -->
    <div class="bg-white p-2 rounded-2xl border border-slate-200 shadow-xs">
      <div class="flex items-center overflow-x-auto gap-2 p-1" id="compartmentTabs">
        <button type="button" data-compartment="all" class="compartment-tab flex-1 min-w-[105px] py-2.5 px-3 rounded-xl flex items-center justify-center space-x-2 text-sm font-bold transition bg-blue-600 text-white shadow-xs shadow-blue-500/20">
          <i class="fa-solid fa-border-all"></i>
          <span>すべて (<span id="count-all">0</span>)</span>
        </button>
        <button type="button" data-compartment="fridge" class="compartment-tab flex-1 min-w-[105px] py-2.5 px-3 rounded-xl flex items-center justify-center space-x-2 text-sm font-bold transition text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-snowflake text-blue-500"></i>
          <span>冷蔵室 (<span id="count-fridge">0</span>)</span>
        </button>
        <button type="button" data-compartment="chilled" class="compartment-tab flex-1 min-w-[105px] py-2.5 px-3 rounded-xl flex items-center justify-center space-x-2 text-sm font-bold transition text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-icicles text-cyan-500"></i>
          <span>チルド室 (<span id="count-chilled">0</span>)</span>
        </button>
        <button type="button" data-compartment="vegetable" class="compartment-tab flex-1 min-w-[105px] py-2.5 px-3 rounded-xl flex items-center justify-center space-x-2 text-sm font-bold transition text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-carrot text-emerald-500"></i>
          <span>野菜室 (<span id="count-vegetable">0</span>)</span>
        </button>
        <button type="button" data-compartment="freezer" class="compartment-tab flex-1 min-w-[105px] py-2.5 px-3 rounded-xl flex items-center justify-center space-x-2 text-sm font-bold transition text-slate-600 hover:bg-slate-100">
          <i class="fa-solid fa-cube text-purple-500"></i>
          <span>冷凍庫 (<span id="count-freezer">0</span>)</span>
        </button>
      </div>
    </div>

    <!-- 検索バー・フィルタ・新規登録ボタン -->
    <div class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
      <div class="flex flex-1 gap-2 items-center">
        <!-- 検索入力 -->
        <div class="relative flex-1">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
          <input type="text" id="searchInput" placeholder="品目名で検索..." class="w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-xs">
        </div>
        <!-- ソート選択 -->
        <select id="sortSelect" class="bg-white border border-slate-200 rounded-xl px-3 py-2 text-sm text-slate-700 font-medium focus:outline-none focus:ring-2 focus:ring-blue-500 transition shadow-xs">
          <option value="expiry_asc">賞味期限が近い順</option>
          <option value="expiry_desc">賞味期限が遠い順</option>
          <option value="purchase_desc">購入日が新しい順</option>
          <option value="purchase_asc">購入日が古い順</option>
          <option value="name_asc">名前順 (A-Z)</option>
        </select>
      </div>

      <!-- 新規アイテム追加ボタン -->
      <button type="button" id="btnOpenAddModal" class="px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md shadow-blue-500/25 flex items-center justify-center space-x-2 font-bold text-sm transition active:scale-95 cursor-pointer">
        <i class="fa-solid fa-plus"></i>
        <span>手動でストック追加</span>
      </button>
    </div>

    <!-- ストック一覧カードグリッド -->
    <div id="stockGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- JavaScriptで動的生成 -->
    </div>

    <!-- 空状態メッセージ -->
    <div id="emptyState" class="hidden flex flex-col items-center justify-center py-16 px-4 text-center bg-white rounded-3xl border border-dashed border-slate-300">
      <div class="w-20 h-20 rounded-full bg-blue-50 text-blue-500 flex items-center justify-center text-3xl mb-4">
        <i class="fa-solid fa-basket-shopping"></i>
      </div>
      <h3 class="text-base font-bold text-slate-700">ストックが見つかりません</h3>
      <p class="text-xs text-slate-500 max-w-sm mt-1">「手動でストック追加」または「レシート読み取り」から食材を登録してみましょう！</p>
      <div class="mt-4 flex gap-2">
        <button type="button" id="btnEmptyAdd" class="px-4 py-2 bg-blue-600 text-white rounded-xl text-xs font-bold shadow hover:bg-blue-700 transition">
          <i class="fa-solid fa-plus mr-1"></i>ストック追加
        </button>
        <button type="button" id="btnEmptyReceipt" class="px-4 py-2 bg-amber-500 text-white rounded-xl text-xs font-bold shadow hover:bg-amber-600 transition">
          <i class="fa-solid fa-receipt mr-1"></i>レシート読み取り
        </button>
      </div>
    </div>
  </main>

  <!-- ======================== モーダル群 ======================== -->

  <!-- 1. アイテム追加 / 編集モーダル -->
  <div id="itemModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-md w-full shadow-2xl border border-slate-100 overflow-hidden my-8">
      <!-- ヘッダー -->
      <div class="px-6 py-4 bg-gradient-to-r from-blue-600 to-indigo-600 text-white flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-box-archive text-lg"></i>
          <h3 id="itemModalTitle" class="font-extrabold text-base">ストックを追加</h3>
        </div>
        <button type="button" class="btn-close-modal text-white/80 hover:text-white text-lg p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- フォーム -->
      <form id="itemForm" class="p-6 space-y-4">
        <input type="hidden" id="itemId">

        <!-- 保管場所（室別選択） -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1.5">
            <i class="fa-solid fa-door-closed text-blue-500 mr-1"></i>保管場所（冷蔵庫各室）
          </label>
          <div class="grid grid-cols-2 gap-2">
            <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 flex items-center space-x-2 hover:bg-blue-50/50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50 has-[:checked]:text-blue-700 transition">
              <input type="radio" name="itemCompartment" value="fridge" class="text-blue-600" checked>
              <span class="text-xs font-bold"><i class="fa-solid fa-snowflake text-blue-500 mr-1"></i>冷蔵室</span>
            </label>
            <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 flex items-center space-x-2 hover:bg-cyan-50/50 has-[:checked]:border-cyan-500 has-[:checked]:bg-cyan-50 has-[:checked]:text-cyan-700 transition">
              <input type="radio" name="itemCompartment" value="chilled" class="text-cyan-600">
              <span class="text-xs font-bold"><i class="fa-solid fa-icicles text-cyan-500 mr-1"></i>チルド室</span>
            </label>
            <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 flex items-center space-x-2 hover:bg-emerald-50/50 has-[:checked]:border-emerald-500 has-[:checked]:bg-emerald-50 has-[:checked]:text-emerald-700 transition">
              <input type="radio" name="itemCompartment" value="vegetable" class="text-emerald-600">
              <span class="text-xs font-bold"><i class="fa-solid fa-carrot text-emerald-500 mr-1"></i>野菜室</span>
            </label>
            <label class="cursor-pointer border border-slate-200 rounded-xl p-2.5 flex items-center space-x-2 hover:bg-purple-50/50 has-[:checked]:border-purple-500 has-[:checked]:bg-purple-50 has-[:checked]:text-purple-700 transition">
              <input type="radio" name="itemCompartment" value="freezer" class="text-purple-600">
              <span class="text-xs font-bold"><i class="fa-solid fa-cube text-purple-500 mr-1"></i>冷凍庫</span>
            </label>
          </div>
        </div>

        <!-- 品目名 -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            <i class="fa-solid fa-tag text-blue-500 mr-1"></i>品目名 <span class="text-rose-500">*</span>
          </label>
          <input type="text" id="itemName" required placeholder="例: 卵、牛乳、鶏もも肉、トマト" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
        </div>

        <!-- 数量と単位 -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              <i class="fa-solid fa-hashtag text-blue-500 mr-1"></i>数量 <span class="text-rose-500">*</span>
            </label>
            <input type="number" id="itemQuantity" step="any" min="0" value="1" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">
              <i class="fa-solid fa-scale-balanced text-blue-500 mr-1"></i>単位
            </label>
            <select id="itemUnit" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition font-medium">
              <option value="個">個 (こ)</option>
              <option value="g">g (グラム)</option>
              <option value="kg">kg (キログラム)</option>
              <option value="ml">ml (ミリリットル)</option>
              <option value="L">L (リットル)</option>
              <option value="本">本 (ほん)</option>
              <option value="パック">パック</option>
              <option value="束">束 (たば)</option>
              <option value="丁">丁 (ちょう)</option>
              <option value="切れ">切れ</option>
              <option value="袋">袋</option>
              <option value="缶">缶</option>
              <option value="枚">枚</option>
              <option value="玉">玉</option>
              <option value="その他">その他</option>
            </select>
          </div>
        </div>

        <!-- 購入日（過去・未来対応） -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            <i class="fa-regular fa-calendar-check text-blue-500 mr-1"></i>購入日 (過去・未来設定可能)
          </label>
          <input type="date" id="itemPurchaseDate" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
        </div>

        <!-- 賞味/消費期限（過去・未来対応） -->
        <div class="grid grid-cols-3 gap-2">
          <div class="col-span-1">
            <label class="block text-xs font-bold text-slate-700 mb-1">期限種別</label>
            <select id="itemExpiryType" class="w-full px-2.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-bold focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="賞味期限">賞味期限</option>
              <option value="消費期限">消費期限</option>
            </select>
          </div>
          <div class="col-span-2">
            <label class="block text-xs font-bold text-slate-700 mb-1">
              期限日付 <span class="text-rose-500">*</span>
            </label>
            <input type="date" id="itemExpiryDate" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
          </div>
        </div>

        <!-- メモ欄 -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            <i class="fa-regular fa-note-sticky text-blue-500 mr-1"></i>メモ（任意）
          </label>
          <input type="text" id="itemMemo" placeholder="例: 開封済み、特売品、半額" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-blue-500 focus:bg-white transition">
        </div>

        <!-- アクションボタン -->
        <div class="pt-3 flex items-center justify-end space-x-2">
          <button type="button" class="btn-close-modal px-4 py-2.5 border border-slate-200 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100 transition">
            キャンセル
          </button>
          <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-xs font-bold shadow-md shadow-blue-500/25 transition">
            保存する
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. レシート読み取りモーダル (Gemini Flash Vision) -->
  <div id="receiptModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden items-center justify-center p-4 overflow-y-auto">
    <div class="bg-white rounded-3xl max-w-xl w-full shadow-2xl border border-slate-100 overflow-hidden my-8">
      <!-- ヘッダー -->
      <div class="px-6 py-4 bg-gradient-to-r from-amber-500 to-orange-500 text-white flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-receipt text-lg"></i>
          <div>
            <h3 class="font-extrabold text-base">レシートAI自動スキャン</h3>
            <p class="text-[11px] text-amber-100">食材のみを自動判別し、日用品や雑貨を賢く除外します</p>
          </div>
        </div>
        <button type="button" class="btn-close-modal text-white/80 hover:text-white text-lg p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="p-6 space-y-4">
        <!-- アップロードエリア -->
        <div id="receiptDropZone" class="border-2 border-dashed border-amber-300 hover:border-amber-500 bg-amber-50/40 rounded-2xl p-6 text-center cursor-pointer transition">
          <input type="file" id="receiptFileInput" accept="image/*" class="hidden">
          <div class="w-14 h-14 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-2xl mx-auto mb-3">
            <i class="fa-solid fa-camera"></i>
          </div>
          <p class="text-sm font-bold text-slate-800">レシートの写真を撮影またはアップロード</p>
