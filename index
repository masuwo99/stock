    async function handleReceiptFile(file) {
      document.getElementById('receiptDropZone').classList.add('hidden');
      document.getElementById('receiptScanningView').classList.remove('hidden');

      try {
        const base64Data = await fileToBase64(file);
        await analyzeReceiptWithGemini(base64Data, file.type);
      } catch (err) {
        console.warn('Receipt API unavailable or failed, switching to smart preview:', err);
        simulateReceiptScanning();
      }
    }

    function fileToBase64(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => {
          const result = reader.result;
          resolve(result.split(',')[1]);
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function analyzeReceiptWithGemini(base64Data, mimeType) {
      const today = new Date().toISOString().split('T')[0];
      const systemPrompt = `
あなたは日本のスーパーや食品店のレシートを正確に判別するAIです。
画像から【食材】と【それ以外（日用品・雑貨・レジ袋など）】を判別し、食材のみをJSONフォーマットで返してください。

形式:
{
  "items": [
    {
      "name": "食材名",
      "compartment": "fridge" または "chilled" または "vegetable" または "freezer",
      "quantity": 1,
      "unit": "個" または "g" または "本" または "パック" または "丁",
      "purchaseDate": "${today}",
      "expiryDays": 7,
      "expiryType": "賞味期限" または "消費期限"
    }
  ],
  "excludedItems": ["サランラップ", "レジ袋"]
}
`;

      const payload = {
        contents: [{
          role: "user",
          parts: [
            { text: "レシートから食材を抽出し、非食材を除外してJSONで出力してください。" },
            { inlineData: { mimeType: mimeType || "image/jpeg", data: base64Data } }
          ]
        }],
        systemInstruction: { parts: [{ text: systemPrompt }] },
        generationConfig: { responseMimeType: "application/json" }
      };

      const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${API_KEY}`;
      const response = await fetch(apiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (!response.ok) throw new Error('API failed');
      const resData = await response.json();
      const rawText = resData.candidates?.[0]?.content?.parts?.[0]?.text;
      const parsed = JSON.parse(rawText);
      displayReceiptResult(parsed);
    }

