  <!-- ======================== アプリケーションスクリプト ======================== -->
  <script>
    /**
     * StockPal メインスクリプト
     * GitHub Pages・ローカルファイル・Canvas環境すべてで安全に動作する耐障害性設計
     */

    const API_KEY = ""; // Canvas環境で自動注入。直接利用時は任意設定可能
    const LOCAL_STORAGE_KEY = 'stockpal_items_v1';
    
    const COMPARTMENT_META = {
      fridge: { name: '冷蔵室', color: 'bg-blue-100 text-blue-700 border-blue-200', icon: 'fa-snowflake', border: 'border-l-blue-500' },
      chilled: { name: 'チルド室', color: 'bg-cyan-100 text-cyan-700 border-cyan-200', icon: 'fa-icicles', border: 'border-l-cyan-500' },
      vegetable: { name: '野菜室', color: 'bg-emerald-100 text-emerald-700 border-emerald-200', icon: 'fa-carrot', border: 'border-l-emerald-500' },
      freezer: { name: '冷凍庫', color: 'bg-purple-100 text-purple-700 border-purple-200', icon: 'fa-cube', border: 'border-l-purple-500' }
    };

    // 初期サンプルデータ
    function getRelativeDate(offsetDays) {
      const d = new Date();
      d.setDate(d.getDate() + offsetDays);
      return d.toISOString().split('T')[0];
    }

    const INITIAL_ITEMS = [
      { id: 'item-1', name: '牛乳', compartment: 'fridge', quantity: 1, unit: 'L', purchaseDate: getRelativeDate(-2), expiryDate: getRelativeDate(3), expiryType: '賞味期限', memo: '未開封', updatedAt: Date.now() },
      { id: 'item-2', name: '卵 (10個入)', compartment: 'fridge', quantity: 8, unit: '個', purchaseDate: getRelativeDate(-4), expiryDate: getRelativeDate(6), expiryType: '賞味期限', memo: '', updatedAt: Date.now() },
      { id: 'item-3', name: '国産 豚ロース薄切り', compartment: 'chilled', quantity: 300, unit: 'g', purchaseDate: getRelativeDate(-1), expiryDate: getRelativeDate(1), expiryType: '消費期限', memo: '今日か明日に使う', updatedAt: Date.now() },
      { id: 'item-4', name: 'キャベツ', compartment: 'vegetable', quantity: 0.5, unit: '個', purchaseDate: getRelativeDate(-3), expiryDate: getRelativeDate(5), expiryType: '賞味期限', memo: '', updatedAt: Date.now() },
      { id: 'item-5', name: '冷凍讃岐うどん', compartment: 'freezer', quantity: 3, unit: '玉', purchaseDate: getRelativeDate(-10), expiryDate: getRelativeDate(60), expiryType: '賞味期限', memo: 'ストック用', updatedAt: Date.now() }
    ];

    // アプリケーション状態
    let items = [];
    let currentFilterCompartment = 'all';
    let searchQuery = '';
    let sortMode = 'expiry_asc';
    let currentRoomId = '';
    let sseEventSource = null;
    let clientId = 'client-' + Math.random().toString(36).substring(2, 9);
    let detectedReceiptItems = [];

    function formatDate(dateStr) {
      if (!dateStr) return '-';
      const parts = dateStr.split('-');
      return parts.length === 3 ? `${parts[1]}/${parts[2]}` : dateStr;
    }

    function getDaysUntilExpiry(expiryDateStr) {
      if (!expiryDateStr) return 999;
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const exp = new Date(expiryDateStr);
      exp.setHours(0, 0, 0, 0);
      return Math.ceil((exp - today) / (1000 * 60 * 60 * 24));
    }

    // --- 安全なストレージ同期 ---
    function loadSavedItems() {
      try {
        const saved = localStorage.getItem(LOCAL_STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {
        console.warn('LocalStorage load skipped:', e);
      }
      return [...INITIAL_ITEMS];
    }

    function persistItemsLocally() {
      try {
        localStorage.setItem(LOCAL_STORAGE_KEY, JSON.stringify(items));
      } catch (e) {
        console.warn('LocalStorage save skipped:', e);
      }
    }

    // --- 安全な初期化エントリーポイント ---
    function initApp() {
      try {
        // 1. ルームIDの初期化 (SecurityError例外ガード)
        initRoom();

        // 2. データの復元
        items = loadSavedItems();

        // 3. UIの即時描画（何があっても真っ白にさせない）
        render();

        // 4. イベントリスナー登録
        setupEventListeners();

        // 5. リアルタイム通信（バックグラウンド非同期）
        setTimeout(connectSyncEngine, 100);
      } catch (err) {
        console.error("Critical init error:", err);
        // 最低限のフォールバック描画
        items = [...INITIAL_ITEMS];
        render();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initApp);
    } else {
      initApp();
    }

    // --- ルーム設定 & 共有初期化 ---
    function initRoom() {
      let roomId = '';
      try {
        const hash = window.location.hash || '';
        const match = hash.match(/room=([^&]+)/);
        if (match && match[1]) {
          roomId = match[1].toLowerCase().replace(/[^a-z0-9_-]/g, '');
        }
      } catch (e) {}

      if (!roomId) {
        roomId = 'stockpal-' + Math.random().toString(36).substring(2, 8);
        try {
          if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', `#room=${roomId}`);
          }
        } catch (e) {
          try { window.location.hash = `#room=${roomId}`; } catch (err) {}
        }
      }

      currentRoomId = roomId;

      const statCode = document.getElementById('statRoomCode');
      const inputRoom = document.getElementById('inputRoomId');
      if (statCode) statCode.textContent = currentRoomId;
      if (inputRoom) inputRoom.value = currentRoomId;

      // QRコード画像（外部API）
      try {
        const shareUrl = `${window.location.origin}${window.location.pathname}#room=${currentRoomId}`;
        const qrUrl = `https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(shareUrl)}`;
        const qrImg = document.getElementById('shareQrCodeImg');
        if (qrImg) qrImg.src = qrUrl;
      } catch (e) {}
    }

    // --- HTTPS SSE & Fetch API ベースのリアルタイム同期 ---
    function connectSyncEngine() {
      if (sseEventSource) {
        try { sseEventSource.close(); } catch(e){}
      }

      const syncIndicator = document.getElementById('syncIndicator');
      const syncStatusText = document.getElementById('syncStatusText');
      const topicUrl = `https://ntfy.sh/${currentRoomId}/sse`;

      try {
        sseEventSource = new EventSource(topicUrl);

        sseEventSource.onopen = () => {
          if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse';
          if (syncStatusText) syncStatusText.textContent = '同期中';
          broadcastSyncEvent({ type: 'REQ_SYNC', sender: clientId });
        };

        sseEventSource.onmessage = (event) => {
          try {
            const data = JSON.parse(event.data);
            if (!data.message) return;
            const payload = JSON.parse(data.message);
            if (payload.sender === clientId) return;
            handleIncomingSync(payload);
          } catch (e) {}
        };

        sseEventSource.onerror = () => {
          if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-amber-500';
          if (syncStatusText) syncStatusText.textContent = 'スタンドアロン';
        };
      } catch (err) {
        if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-slate-400';
        if (syncStatusText) syncStatusText.textContent = 'ローカル稼働';
      }
    }

    async function broadcastSyncEvent(action) {
      action.sender = clientId;
      action.timestamp = Date.now();

      try {
        await fetch(`https://ntfy.sh/${currentRoomId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(action)
        });
      } catch (e) {}
    }

    function handleIncomingSync(payload) {
      switch (payload.type) {
        case 'REQ_SYNC':
          broadcastSyncEvent({ type: 'RES_SYNC', items: items });
          break;
        case 'RES_SYNC':
          if (Array.isArray(payload.items) && payload.items.length > 0) {
            items = payload.items;
            persistItemsLocally();
            render();
            showToast('家族の最新ストックと同期しました', 'info');
          }
          break;
        case 'ITEM_ADDED':
          if (!items.some(i => i.id === payload.item.id)) {
            items.unshift(payload.item);
            persistItemsLocally();
            render();
            showToast(`追加されました: ${payload.item.name}`, 'info');
          }
          break;
        case 'ITEM_UPDATED':
          const idx = items.findIndex(i => i.id === payload.item.id);
          if (idx !== -1) {
            items[idx] = payload.item;
            persistItemsLocally();
            render();
            showToast(`更新されました: ${payload.item.name}`, 'info');
          }
          break;
        case 'ITEM_DELETED':
          items = items.filter(i => i.id !== payload.id);
          persistItemsLocally();
          render();
          showToast('アイテムが消費・削除されました', 'info');
          break;
        case 'BATCH_ADDED':
          if (Array.isArray(payload.newItems)) {
            items = [...payload.newItems, ...items];
            persistItemsLocally();
            render();
            showToast(`${payload.newItems.length}件のストックが同期されました`, 'success');
          }
          break;
      }
    }

    // --- UI イベントリスナー登録 ---
    function setupEventListeners() {
      // 室別タブ
      document.querySelectorAll('.compartment-tab').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.compartment-tab').forEach(b => {
            b.classList.remove('bg-blue-600', 'text-white', 'shadow-xs', 'shadow-blue-500/20');
            b.classList.add('text-slate-600', 'hover:bg-slate-100');
          });
          btn.classList.add('bg-blue-600', 'text-white', 'shadow-xs', 'shadow-blue-500/20');
          btn.classList.remove('text-slate-600', 'hover:bg-slate-100');

          currentFilterCompartment = btn.dataset.compartment;
          render();
        });
      });

      // 検索・ソート
      const searchInput = document.getElementById('searchInput');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          render();
        });
      }

      const sortSelect = document.getElementById('sortSelect');
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          sortMode = e.target.value;
          render();
        });
      }

      // モーダルクローズ
      document.querySelectorAll('.btn-close-modal').forEach(btn => {
        btn.addEventListener('click', closeAllModals);
      });

      // 追加ボタン
      const btnAdd = document.getElementById('btnOpenAddModal');
      if (btnAdd) btnAdd.addEventListener('click', () => openItemModal());

      const btnEmptyAdd = document.getElementById('btnEmptyAdd');
      if (btnEmptyAdd) btnEmptyAdd.addEventListener('click', () => openItemModal());

      // アイテム保存
      const itemForm = document.getElementById('itemForm');
      if (itemForm) {
        itemForm.addEventListener('submit', (e) => {
          e.preventDefault();
          saveItemFromForm();
        });
      }

      // 共有モーダル
      const btnShare = document.getElementById('btnShareModal');
      if (btnShare) {
        btnShare.addEventListener('click', () => {
          const m = document.getElementById('shareModal');
          m.classList.remove('hidden');
          m.classList.add('flex');
        });
      }

      const btnCopy = document.getElementById('btnCopyShareUrl');
      if (btnCopy) {
        btnCopy.addEventListener('click', () => {
          const shareUrl = `${window.location.origin}${window.location.pathname}#room=${currentRoomId}`;
          copyToClipboard(shareUrl);
          showToast('共有リンクをクリップボードにコピーしました！', 'success');
        });
      }

      const btnJoin = document.getElementById('btnJoinRoom');
      if (btnJoin) {
        btnJoin.addEventListener('click', () => {
          const newRoom = document.getElementById('inputJoinRoomId').value.trim();
          if (newRoom) {
            window.location.hash = `#room=${newRoom}`;
            window.location.reload();
          }
        });
      }

      // レシートモーダル
      const btnReceipt = document.getElementById('btnOpenReceiptModal');
      if (btnReceipt) {
        btnReceipt.addEventListener('click', () => {
          resetReceiptModal();
          const m = document.getElementById('receiptModal');
          m.classList.remove('hidden');
          m.classList.add('flex');
        });
      }

      const btnEmptyReceipt = document.getElementById('btnEmptyReceipt');
      if (btnEmptyReceipt) {
        btnEmptyReceipt.addEventListener('click', () => {
          resetReceiptModal();
          const m = document.getElementById('receiptModal');
          m.classList.remove('hidden');
          m.classList.add('flex');
        });
      }

      const btnSelect = document.getElementById('btnSelectFile');
      const fileInput = document.getElementById('receiptFileInput');
      if (btnSelect && fileInput) {
        btnSelect.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
          const file = e.target.files[0];
          if (file) handleReceiptFile(file);
        });
      }

      const btnTestReceipt = document.getElementById('btnTestReceipt');
      if (btnTestReceipt) {
        btnTestReceipt.addEventListener('click', simulateReceiptScanning);
      }

