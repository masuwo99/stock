    // --- 描画処理 ---
    function render() {
      updateCountsAndStats();

      const grid = document.getElementById('stockGrid');
      const empty = document.getElementById('emptyState');
      if (!grid) return;

      grid.innerHTML = '';

      let filtered = items.filter(item => {
        const matchesComp = (currentFilterCompartment === 'all') || (item.compartment === currentFilterCompartment);
        const matchesQuery = !searchQuery || item.name.toLowerCase().includes(searchQuery) || (item.memo && item.memo.toLowerCase().includes(searchQuery));
        return matchesComp && matchesQuery;
      });

      filtered.sort((a, b) => {
        if (sortMode === 'expiry_asc') return (a.expiryDate || '9999') > (b.expiryDate || '9999') ? 1 : -1;
        if (sortMode === 'expiry_desc') return (a.expiryDate || '0000') < (b.expiryDate || '0000') ? 1 : -1;
        if (sortMode === 'purchase_desc') return (a.purchaseDate || '0000') < (b.purchaseDate || '0000') ? 1 : -1;
        if (sortMode === 'purchase_asc') return (a.purchaseDate || '9999') > (b.purchaseDate || '9999') ? 1 : -1;
        if (sortMode === 'name_asc') return a.name.localeCompare(b.name, 'ja');
        return 0;
      });

      if (filtered.length === 0) {
        if (empty) empty.classList.remove('hidden');
      } else {
        if (empty) empty.classList.add('hidden');
      }

      filtered.forEach(item => {
        const card = createItemCard(item);
        grid.appendChild(card);
      });
    }

    function updateCountsAndStats() {
      const counts = { all: items.length, fridge: 0, chilled: 0, vegetable: 0, freezer: 0 };
      let expiringSoon = 0;
      let expired = 0;

      items.forEach(item => {
        if (counts[item.compartment] !== undefined) counts[item.compartment]++;
        const days = getDaysUntilExpiry(item.expiryDate);
        if (days < 0) expired++;
        else if (days <= 3) expiringSoon++;
      });

      const setTxt = (id, val) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      };

      setTxt('count-all', counts.all);
      setTxt('count-fridge', counts.fridge);
      setTxt('count-chilled', counts.chilled);
      setTxt('count-vegetable', counts.vegetable);
      setTxt('count-freezer', counts.freezer);

      setTxt('statTotalItems', items.length);
      setTxt('statExpiringSoon', expiringSoon);
      setTxt('statExpired', expired);
    }

