    function displayReceiptResult(data) {
      document.getElementById('receiptScanningView').classList.add('hidden');
      document.getElementById('receiptResultView').classList.remove('hidden');

      const foodList = document.getElementById('receiptFoodList');
      const excludedList = document.getElementById('excludedItemsList');
      foodList.innerHTML = '';
      excludedList.innerHTML = '';

      const detected = Array.isArray(data.items) ? data.items : [];
      const excluded = Array.isArray(data.excludedItems) ? data.excludedItems : [];

      detectedReceiptItems = detected.map((it, idx) => {
        const baseDate = new Date(it.purchaseDate || getRelativeDate(0));
        baseDate.setDate(baseDate.getDate() + (it.expiryDays || 5));
        const expDateStr = baseDate.toISOString().split('T')[0];

        return {
          id: 'receipt-' + Date.now() + '-' + idx,
          name: it.name,
          compartment: it.compartment || 'fridge',
          quantity: it.quantity || 1,
          unit: it.unit || '個',
          purchaseDate: it.purchaseDate || getRelativeDate(0),
          expiryDate: expDateStr,
          expiryType: it.expiryType || '賞味期限',
          memo: 'レシート読取',
          selected: true
        };
      });

      document.getElementById('detectedFoodCount').textContent = `${detectedReceiptItems.length}件`;
      document.getElementById('excludedItemCount').textContent = excluded.length;

      detectedReceiptItems.forEach((item, index) => {
        const row = document.createElement('div');
        row.className = 'p-3 flex items-center justify-between gap-2 hover:bg-slate-50 transition';
        row.innerHTML = `
          <div class="flex items-center space-x-3">
            <input type="checkbox" checked id="chk-item-${index}" class="w-4 h-4 text-amber-600 rounded border-slate-300 focus:ring-amber-500">
            <div>
              <p class="text-xs font-bold text-slate-800">${escapeHtml(item.name)}</p>
              <div class="flex items-center space-x-2 text-[10px] text-slate-500 mt-0.5">
                <span class="px-1.5 py-0.2 rounded bg-slate-100 text-slate-700 font-semibold">${COMPARTMENT_META[item.compartment]?.name || '冷蔵室'}</span>
                <span>${item.quantity} ${item.unit}</span>
                <span>期限: ${formatDate(item.expiryDate)}</span>
              </div>
            </div>
          </div>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">食材認定</span>
        `;

        row.querySelector(`#chk-item-${index}`).addEventListener('change', (e) => {
          detectedReceiptItems[index].selected = e.target.checked;
        });

        foodList.appendChild(row);
      });

      if (excluded.length === 0) {
        excludedList.innerHTML = '<li class="text-slate-400">除外された日用品はありませんでした。</li>';
      } else {
        excluded.forEach(name => {
          const li = document.createElement('li');
          li.textContent = name;
          excludedList.appendChild(li);
        });
      }
