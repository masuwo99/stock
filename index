      setTimeout(() => {
        const dummyResult = {
          items: [
            { name: "たまご 10個入", compartment: "fridge", quantity: 1, unit: "パック", purchaseDate: getRelativeDate(0), expiryDays: 14, expiryType: "賞味期限" },
            { name: "若鶏モモ肉", compartment: "chilled", quantity: 450, unit: "g", purchaseDate: getRelativeDate(0), expiryDays: 2, expiryType: "消費期限" },
            { name: "きゅうり", compartment: "vegetable", quantity: 3, unit: "本", purchaseDate: getRelativeDate(0), expiryDays: 5, expiryType: "賞味期限" },
            { name: "木綿豆腐", compartment: "chilled", quantity: 1, unit: "丁", purchaseDate: getRelativeDate(0), expiryDays: 4, expiryType: "消費期限" },
            { name: "冷凍ギョーザ", compartment: "freezer", quantity: 1, unit: "パック", purchaseDate: getRelativeDate(0), expiryDays: 90, expiryType: "賞味期限" }
          ],
          excludedItems: ["サランラップ 22cm", "花王 食器用洗剤", "レジ袋 Mサイズ"]
        };
        displayReceiptResult(dummyResult);
      }, 1000);
