          <div class="mt-2.5 flex flex-wrap gap-1.5 items-center">
            <span class="text-[10px] font-bold text-slate-500">消費できる食材:</span>
            ${(plan.consumedStockItems || []).map(ing => `<span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-white text-teal-800 border border-teal-200 shadow-2xs">${escapeHtml(ing)}</span>`).join('')}
          </div>
        </div>

        <div class="space-y-3 pt-1">
          <h4 class="text-xs font-extrabold text-slate-700 uppercase tracking-wider">構成メニュー & レシピ</h4>
          ${plan.dishes.map(dish => `
            <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-2xs">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center space-x-2">
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold ${dish.type === '主菜' ? 'bg-orange-100 text-orange-700' : dish.type === '副菜' ? 'bg-emerald-100 text-emerald-700' : 'bg-blue-100 text-blue-700'}">${escapeHtml(dish.type)}</span>
                  <span class="font-bold text-sm text-slate-800">${escapeHtml(dish.name)}</span>
                </div>
                <span class="text-xs text-slate-400 font-medium"><i class="fa-regular fa-clock mr-1"></i>${escapeHtml(dish.cookingTime || '10分')}</span>
              </div>
              <p class="text-[11px] text-slate-500 mb-2">
                <strong>使用食材:</strong> ${dish.usedIngredients.map(u => escapeHtml(u)).join(', ')}
              </p>
              <div class="bg-slate-50 rounded-xl p-2.5 text-xs text-slate-600 space-y-1">
                ${dish.recipeSteps.map((step, idx) => `
                  <div class="flex items-start space-x-2">
                    <span class="font-bold text-slate-400 text-[10px]">${idx + 1}.</span>
                    <span class="text-[11px]">${escapeHtml(step)}</span>
                  </div>
                `).join('')}
              </div>
            </div>
          `).join('')}
        </div>
      `;
    }

    function renderFallbackMealPlan() {
      const fallback = {
        menuTitle: "冷蔵・チルド食材をスピード使い切り！野菜たっぷりバランス定食",
        nutritionHighlight: "チルド室のタンパク質と野菜室の食物繊維・ビタミンを組み合わせ、賞味期限の近い食材を一気に美味しく消費します。",
        consumedStockItems: ["豚肉", "キャベツ", "卵", "豆腐"],
        dishes: [
          {
            name: "豚肉とキャベツのスタミナ味噌炒め",
            type: "主菜",
            cookingTime: "12分",
            usedIngredients: ["豚肉", "キャベツ"],
            recipeSteps: [
              "キャベツをざく切りにし、豚肉は一口大に切る。",
              "フライパンに油を熱し、豚肉を炒めて色が変わったらキャベツを加える。",
              "味噌、みりん、醤油各小さじ2を絡めて強火でさっと炒め合わせる。"
            ]
          },
          {
            name: "ふわふわ卵と豆腐のかき玉スープ",
            type: "汁物",
            cookingTime: "8分",
            usedIngredients: ["卵", "豆腐"],
            recipeSteps: [
              "小鍋に水300mlと和風だし、醤油を煮立て、さいの目切りにした豆腐を入れる。",
              "水溶き片栗粉で軽くとろみをつけ、溶き卵を回し入れて火を止める。"
            ]
          }
        ]
      };
      renderMealPlan(fallback);
    }

    // --- 汎用ユーティリティ ---
    function copyToClipboard(text) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).catch(() => fallbackCopy(text));
      } else {
        fallbackCopy(text);
      }
    }

    function fallbackCopy(text) {
      const textArea = document.createElement("textarea");
      textArea.value = text;
      textArea.style.position = "fixed";
      document.body.appendChild(textArea);
      textArea.focus();
      textArea.select();
      try { document.execCommand('copy'); } catch (err) {}
      document.body.removeChild(textArea);
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      if (!container) return;
      const toast = document.createElement('div');

      let icon = 'fa-circle-info text-blue-500';
      let border = 'border-blue-200';
      if (type === 'success') { icon = 'fa-circle-check text-emerald-500'; border = 'border-emerald-200'; }
      if (type === 'error') { icon = 'fa-circle-exclamation text-rose-500'; border = 'border-rose-200'; }

      toast.className = `glass-effect border ${border} px-4 py-2.5 rounded-2xl shadow-lg flex items-center space-x-2 text-xs font-bold text-slate-800 pointer-events-auto`;
      toast.innerHTML = `<i class="fa-solid ${icon}"></i><span>${escapeHtml(message)}</span>`;

      container.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'transition-opacity');
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  </script>
</body>
